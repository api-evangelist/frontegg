        {
          "id": "c4230fe1-48d7-40ee-aa84-43116c810660",
          "name": "Get Accounts (tenants)",
          "request": {
            "name": "Get Accounts (tenants)",
            "description": {
              "content": "Retrieve all accounts (tenants) for an environment.\n\nSupports filtering, sorting, and pagination. You can filter by account name or account (tenant) ID, sort by `createdAt`, `name`, or `tenantId`, and specify the order (`ASC` or `DESC`).\n\nYou can also provide specific account (tenant) IDs to retrieve only those accounts (tenants). The default limit is 50 accounts (tenants) per request; the maximum is 200.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "resources",
                "tenants",
                "v2"
              ],
              "host": [
                "{{resources-tenants-v2-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "_limit",
                  "value": "<number>",
                  "description": "The default limit is 50 accounts (tenants) per request, the maximum is 200"
                },
                {
                  "disabled": false,
                  "key": "_offset",
                  "value": "<number>"
                },
                {
                  "disabled": false,
                  "key": "_filter",
                  "value": "<string>",
                  "description": "This param allows filtering the request using an account's name or tenantId"
                },
                {
                  "disabled": false,
                  "key": "_sortBy",
                  "value": "<string>",
                  "description": "This param allows sorting the results via createdAt, name, tenantId"
                },
                {
                  "disabled": false,
                  "key": "_order",
                  "value": "<string>",
                  "description": "This param can be used together with sortBy and define the order as ACS or DESC"
                },
                {
                  "disabled": false,
                  "key": "_tenantIds",
                  "value": "<string>",
                  "description": "This param allows passing specific tenantIds and getting only these accounts (tenants) data"
