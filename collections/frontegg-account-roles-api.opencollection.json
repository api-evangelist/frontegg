            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.frontegg.com/applications/resources/roles/v2",
            "headers": [
              {
                "name": "frontegg-tenant-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a new role for a specific account (tenant).\n\nInclude the required permissions in the request body to customize the role."
        },
        {
          "info": {
            "name": "Get Distinct Levels of Roles",
            "type": "http"
