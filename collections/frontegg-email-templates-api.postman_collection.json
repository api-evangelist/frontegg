          "name": "Add or Update Template",
          "request": {
            "name": "Add or Update Template",
            "description": {
              "content": "Create or update an email template for your environment.\n\nSpecify the email template using the `type` parameter. The value of `type` must match one of the predefined Frontegg email templates. Set the sender using the `senderEmail` parameter, and optionally include values for the other available body parameters. Provide the template information in the request body.\n\nA valid environment token is required to call this endpoint. You can obtain it from the environment authentication route.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "resources",
                "mail",
                "v1",
                "configs",
                "templates"
              ],
              "host": [
                "{{resources-mail-v1-configs-templates-Url}}"
              ],
              "query": [],
              "variable": []
            },
