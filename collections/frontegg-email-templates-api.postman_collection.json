            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"<string>\",\n  \"senderEmail\": \"<string>\",\n  \"subject\": \"<string>\",\n  \"fromName\": \"<string>\",\n  \"redirectURL\": \"<string>\",\n  \"htmlTemplate\": \"<string>\",\n  \"successRedirectUrl\": \"<string>\",\n  \"active\": \"<boolean>\"\n}",
