          "name": "Authenticate User with Password",
          "request": {
            "name": "Authenticate User with Password",
            "description": {
              "content": "Authenticate a local user using their email and password.\n\nInclude the user's login credentials in the request body. This endpoint supports optional parameters such as an invitation token (for sign-up flows via invitation) and a reCAPTCHA token (if reCAPTCHA is enabled for login).\n\nIf the credentials are valid, the response includes a signed JWT and a refresh token that can be used for future authenticated requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "resources",
                "auth",
                "v1",
                "user"
              ],
              "host": [
                "{{resources-auth-v1-user-Url}}"
              ],
              "query": [],
              "variable": []
            },
