          "info": {
            "name": "Get User Access Tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/resources/users/access-tokens/v1",
            "headers": [
              {
                "name": "frontegg-tenant-id",
                "value": ""
              },
              {
                "name": "frontegg-user-id",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve all access tokens for a specific user."
        },
        {
          "info": {
            "name": "Create User Access Token",
            "type": "http"
          },
          "http": {
