            "params": [
              {
                "name": "configurationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domainId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Validate a domain in a Single Sign-On (SSO) configuration for the specified account (tenant)."
        },
