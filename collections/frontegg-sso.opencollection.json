            "params": [
              {
                "name": "configurationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domainId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Validate a domain in a Single Sign-On (SSO) configuration using the user's email domain."
        },
        {
          "info": {
            "name": "Validate SSO Domain",
            "type": "http"
