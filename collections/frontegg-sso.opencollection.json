            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a domain to a Single Sign-On (SSO) configuration for the specified account (tenant)."
        },
        {
          "info": {
            "name": "Delete SSO Domain",
            "type": "http"
