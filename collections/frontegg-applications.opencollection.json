{
  "opencollection": "1.0.0",
  "info": {
    "name": "Multi-Apps Overview",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Applications Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Applications for an Environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/resources/applications/v1",
            "params": [
              {
                "name": "_accessType",
                "value": "",
                "type": "query"
              },
              {
                "name": "_isDefault",
                "value": "",
                "type": "query"
              },
              {
                "name": "_isActive",
                "value": "",
                "type": "query"
              },
              {
                "name": "ids",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "frontendStack",
                "value": "",
                "type": "query"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter applications by name (case-insensitive partial match)"
              },
              {
                "name": "_excludeAgents",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a list of all applications configured within the current environment. You can optionally filter the results by access type, default status, active status, or specific application IDs. This route requires an environment token for authentication."
        },
        {
          "info": {
            "name": "Create Application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.frontegg.com/applications/resources/applications/v1",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new application within the current environment. You must provide basic information such as the application's name, URLs, and access type. You can also configure optional fields like the frontend stack, logo, default status, and metadata. This route requires an environment token for authentication."
        },
        {
          "info": {
            "name": "Get the Default Application for an Environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/resources/applications/v1/default"
          },
          "docs": "Retrieve the default application configured in the current environment. The default application typically defines the primary application used for user access and authentication flows. This route requires an environment token for authentication."
        },
        {
          "info": {
            "name": "Get Application by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/resources/applications/v1/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the details of a specific application by its unique ID within the current environment. Use this route to fetch configuration, metadata, and status information for a given application. This request requires an environment token for authentication."
        },
        {
          "info": {
            "name": "Update an Application",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.frontegg.com/applications/resources/applications/v1/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the configuration of an existing application by its ID. You can modify fields such as the name, URLs, access type, status, frontend stack, and additional metadata. This request requires an environment token for authentication."
        },
        {
          "info": {
            "name": "Delete an Application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.frontegg.com/applications/resources/applications/v1/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an existing application by its ID from the current environment. This action permanently removes the application and its associated configuration. This request requires an environment token for authentication."
        },
        {
          "info": {
            "name": "Get Application to Accounts (tenants) Assignments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/resources/applications/tenant-assignments/v1",
            "headers": [
              {
                "name": "frontegg-tenant-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "appIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "tenantIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "accessType",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve the list of applications assigned to specific accounts (tenants), or the list of accounts (tenants) associated with specific applications. You can filter the results using `appIds` or `tenantIds` query parameters. This request requires an environment token."
        },
        {
          "info": {
            "name": "Get Account (tenant) Assignments for an Application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/resources/applications/tenant-assignments/v1/:appId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve all account (tenant) IDs currently assigned to a specific application.\n\nSend the application ID as a path parameter."
        },
        {
          "info": {
            "name": "Create Application to Account (tenant) Assignment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.frontegg.com/applications/resources/applications/tenant-assignments/v1/:appId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Assign an application to a specific account (tenant).\n\nProvide the application ID as a path parameter and the target account (tenant) ID in the request body."
        },
        {
          "info": {
            "name": "Edit Application to Tenant Assignment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.frontegg.com/applications/resources/applications/tenant-assignments/v1/:appId/:tenantId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tenantId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edit application to tenant assignment"
        },
        {
          "info": {
            "name": "Delete Application to Account (tenant) Assignment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.frontegg.com/applications/resources/applications/tenant-assignments/v1/:appId/:tenantId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tenantId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove the assignment of an application from a specific account (tenant)."
        },
        {
          "info": {
            "name": "Get Tenant Application Assignments with Per-app AccessType",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/resources/applications/tenant-assignments/v2",
            "headers": [
              {
                "name": "frontegg-tenant-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "appIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "tenantIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "accessType",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get tenant application assignments with per-app accessType"
        },
        {
          "info": {
            "name": "Get Application Client Credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/resources/applications/v1/credentials/:appId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the client credentials for a specific application. These credentials include both the `clientSecret` and the `sharedSecret`, which are required for authentication and secure communication with the application."
        },
        {
          "info": {
            "name": "Regenerate Application Client Credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.frontegg.com/applications/resources/applications/v1/credentials/regenerate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Regenerate the client credentials (client ID and secret) for a specific application. Use this route to issue a new set of credentials for the application. This request requires an environment token for authentication."
        },
        {
          "info": {
            "name": "Regenerate Application Shared Secret Credential",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.frontegg.com/applications/resources/applications/v1/credentials/shared/regenerate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Regenerate the shared secret credential for a specific application. Use this route to issue a new shared secret that the application can use for authentication. This request requires an environment token for authentication."
        },
        {
          "info": {
            "name": "Create Application Client",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.frontegg.com/applications/application-clients",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Application Client"
        },
        {
          "info": {
            "name": "Get Application Clients by App ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/application-clients/app/:appId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Application Clients by App ID"
        },
        {
          "info": {
            "name": "Get Application Client by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frontegg.com/applications/application-clients/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Application Client by ID"
        },
        {
          "info": {
            "name": "Update Application Client",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.frontegg.com/applications/application-clients/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Application Client"
        },
        {
          "info": {
            "name": "Delete Application Client",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.frontegg.com/applications/application-clients/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Application Client"
        }
      ]
    }
  ],
  "bundled": true
}